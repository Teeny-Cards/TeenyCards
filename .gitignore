# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.DS_Store
dist
dist-ssr
coverage
*.local

/cypress/videos/
/cypress/screenshots/

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Vitest browser mode (failure attachments + auto-generated screenshots)
.vitest-attachments/
**/__screenshots__/

# VitePress build artifacts (dist is caught by `dist` above; cache is not)
docs/.vitepress/cache/
docs/.vitepress/dist/

# Editor directories and files
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
**/DO_NOT_COMMIT.*

*.tsbuildinfo
.env
*.env.*


# Type-bucketed schema drift snapshot (scripts/dump-schemas)
supabase/.schema-snapshot/

# Agent worktrees — git tracks them via .git/info/exclude, which the formatter
# doesn't read, so a whole-tree `vp fmt` would rewrite files inside a sibling run
.claude/worktrees/
